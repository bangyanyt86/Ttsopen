import React, { useState, useEffect, useRef } from 'react';
import { 
  Volume2, Settings, Zap, Crown, MessageSquare, Sparkles, 
  Trash2, AlertCircle, CheckCircle, Wand2, PlayCircle, 
  Loader2, Music, Download, Key, Save, X 
} from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { getFirestore } from 'firebase/firestore';
import { getAuth, signInAnonymously } from 'firebase/auth';

// --- Assets & Constants ---
const GEMINI_VOICES = [
  { name: 'Kore', label: 'Kore (Default)' },
  { name: 'Zephyr', label: 'Zephyr (Deep)' },
  { name: 'Puck', label: 'Puck (Cheerful)' },
  { name: 'Charon', label: 'Charon (Calm)' },
  { name: 'Fenrir', label: 'Fenrir (Bold)' }
];

const ELEVENLABS_PRESETS = [
  { id: '21m00Tcm4TlvDq8ikWAM', name: 'Rachel', description: 'American, Clear' },
  { id: 'pNInz6obpgDQGcFmaJgB', name: 'Adam', description: 'American, Deep' },
  { id: 'ErXwobaYiN019PkySvjV', name: 'Antoni', description: 'American, Well-rounded' },
  { id: 'AZnzlk1XvdvUeBnXmlld', name: 'Domi', description: 'American, Strong' },
  { id: 'EXAVITQu4vr4xnSDxMaL', name: 'Bella', description: 'American, Soft' }
];

const STYLE_PRESETS = ["Marah", "Ceria", "Datar", "Sarkas", "Berbisik"];

export default function App() {
  // --- State Management ---
  const [activeTab, setActiveTab] = useState('gemini'); // 'gemini' or 'eleven'
  const [script, setScript] = useState('');
  const [styleInstruction, setStyleInstruction] = useState('');
  const [selectedGeminiVoice, setSelectedGeminiVoice] = useState('Kore');
  const [selectedElevenVoiceId, setSelectedElevenVoiceId] = useState(ELEVENLABS_PRESETS[0].id);
  const [isSettingsOpen, setIsSettingsOpen] = useState(false);
  const [elevenLabsApiKey, setElevenLabsApiKey] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [audioUrl, setAudioUrl] = useState(null);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  const apiKey = ""; // Gemini API Key managed by environment

  // --- Handlers ---
  const handleGenerate = async () => {
    if (!script.trim()) {
      setError("Script tidak boleh kosong!");
      return;
    }

    setIsLoading(true);
    setError('');
    setSuccess('');
    setAudioUrl(null);

    try {
      if (activeTab === 'gemini') {
        await generateGeminiTTS();
      } else {
        await generateElevenLabsTTS();
      }
    } catch (err) {
      setError(err.message || "Gagal membuat audio.");
    } finally {
      setIsLoading(false);
    }
  };

  const generateGeminiTTS = async (retryCount = 0) => {
    const prompt = `Say in a ${styleInstruction || 'neutral'} way: ${script}`;
    const payload = {
      contents: [{ parts: [{ text: prompt }] }],
      generationConfig: {
        responseModalities: ["AUDIO"],
        speechConfig: {
          voiceConfig: {
            prebuiltVoiceConfig: { voiceName: selectedGeminiVoice }
          }
        }
      }
    };

    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!response.ok) throw new Error("Gagal menghubungi Gemini.");

      const result = await response.json();
      const pcmData = result.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data;
      
      if (!pcmData) throw new Error("Data audio tidak ditemukan.");

      // Convert PCM to WAV for playback
      const wavBlob = pcmToWav(pcmData, 24000); // Assuming 24kHz
      setAudioUrl(URL.createObjectURL(wavBlob));
      setSuccess("Audio Gemini berhasil dibuat!");
    } catch (err) {
      if (retryCount < 5) {
        const delay = Math.pow(2, retryCount) * 1000;
        await new Promise(r => setTimeout(r, delay));
        return generateGeminiTTS(retryCount + 1);
      }
      throw err;
    }
  };

  const generateElevenLabsTTS = async () => {
    if (!elevenLabsApiKey) {
      throw new Error("API Key ElevenLabs belum diatur di Settings.");
    }

    const response = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${selectedElevenVoiceId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'xi-api-key': elevenLabsApiKey
      },
      body: JSON.stringify({
        text: script,
        model_id: "eleven_monolingual_v1",
        voice_settings: { stability: 0.5, similarity_boost: 0.5 }
      })
    });

    if (!response.ok) throw new Error("Gagal menghubungi ElevenLabs. Cek API Key Anda.");

    const blob = await response.blob();
    setAudioUrl(URL.createObjectURL(blob));
    setSuccess("Audio ElevenLabs berhasil dibuat!");
  };

  const handleAiAutoWrite = async () => {
    if (!script.trim()) return;
    setIsLoading(true);
    try {
      const prompt = `Perhalus atau buat teks berikut menjadi lebih ekspresif untuk dibacakan (TTS): "${script}"`;
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
      });
      const result = await response.json();
      const improvedText = result.candidates?.[0]?.content?.parts?.[0]?.text;
      if (improvedText) setScript(improvedText.trim());
    } catch (err) {
      setError("Gagal memperhalus teks.");
    } finally {
      setIsLoading(false);
    }
  };

  // Helper: PCM to WAV conversion (Standard for Gemini TTS output)
  const pcmToWav = (base64Data, sampleRate) => {
    const byteCharacters = atob(base64Data);
    const byteNumbers = new Array(byteCharacters.length);
    for (let i = 0; i < byteCharacters.length; i++) {
      byteNumbers[i] = byteCharacters.charCodeAt(i);
    }
    const byteArray = new Uint8Array(byteNumbers);
    const buffer = byteArray.buffer;
    
    const wavHeader = new ArrayBuffer(44);
    const view = new DataView(wavHeader);
    
    view.setUint32(0, 0x52494646, false); // "RIFF"
    view.setUint32(4, 36 + buffer.byteLength, true);
    view.setUint32(8, 0x57415645, false); // "WAVE"
    view.setUint32(12, 0x666d7420, false); // "fmt "
    view.setUint32(16, 16, true);
    view.setUint16(20, 1, true); // PCM
    view.setUint16(22, 1, true); // Mono
    view.setUint32(24, sampleRate, true);
    view.setUint32(28, sampleRate * 2, true);
    view.setUint16(32, 2, true);
    view.setUint16(34, 16, true);
    view.setUint32(36, 0x64617461, false); // "data"
    view.setUint32(40, buffer.byteLength, true);

    const blob = new Blob([wavHeader, buffer], { type: 'audio/wav' });
    return blob;
  };

  return (
    <div className="min-h-screen bg-neutral-950 text-neutral-200 font-sans selection:bg-lime-500/30">
      
      {/* Header (Sticky) */}
      <header className="sticky top-0 z-40 bg-neutral-950/80 backdrop-blur-md border-b border-white/5">
        <div className="max-w-4xl mx-auto px-6 h-20 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-lime-400 to-lime-600 flex items-center justify-center shadow-lg shadow-lime-500/20">
              <Volume2 className="text-neutral-900 w-6 h-6" />
            </div>
            <div>
              <h1 className="text-xl font-black tracking-tighter">
                NYE<span className="text-lime-500">TAK</span>
              </h1>
              <p className="text-[10px] text-neutral-500 font-medium uppercase tracking-widest">Bacot Pake Text</p>
            </div>
          </div>
          
          <button 
            onClick={() => setIsSettingsOpen(true)}
            className={`p-2.5 rounded-xl border transition-all flex items-center gap-2 ${
              elevenLabsApiKey 
                ? 'border-lime-500/50 bg-lime-500/10 text-lime-500' 
                : 'border-white/10 bg-neutral-900 text-neutral-400 hover:border-white/20'
            }`}
          >
            {elevenLabsApiKey && <span className="text-xs font-bold hidden sm:inline">API READY</span>}
            <Settings className={`w-5 h-5 ${elevenLabsApiKey ? 'animate-pulse' : ''}`} />
          </button>
        </div>
      </header>

      <main className="max-w-4xl mx-auto px-6 py-8 space-y-8">
        
        {/* Mode Switcher */}
        <div className="bg-neutral-900 p-1.5 rounded-2xl flex gap-1 shadow-inner border border-white/5">
          <button 
            onClick={() => setActiveTab('gemini')}
            className={`flex-1 flex items-center justify-center gap-2 py-3 rounded-xl font-bold transition-all ${
              activeTab === 'gemini' 
                ? 'bg-lime-500 text-neutral-950 shadow-lg' 
                : 'text-neutral-400 hover:text-white'
            }`}
          >
            <Zap className="w-4 h-4" />
            Gemini Flash
          </button>
          <button 
            onClick={() => setActiveTab('eleven')}
            className={`flex-1 flex items-center justify-center gap-2 py-3 rounded-xl font-bold transition-all ${
              activeTab === 'eleven' 
                ? 'bg-white text-neutral-950 shadow-lg' 
                : 'text-neutral-400 hover:text-white'
            }`}
          >
            <Crown className="w-4 h-4" />
            ElevenLabs
          </button>
        </div>

        {/* Main Grid Layout */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          {/* Kolom Kiri: Konfigurasi */}
          <div className="space-y-6">
            <div className="bg-neutral-900 rounded-3xl border border-white/5 shadow-xl p-5 space-y-5">
              <div className="flex items-center gap-2 text-[10px] font-bold text-neutral-500 tracking-widest uppercase">
                <Settings className="w-3 h-3" />
                Konfigurasi
              </div>

              {activeTab === 'gemini' ? (
                <div className="space-y-4">
                  <div>
                    <label className="text-xs font-semibold text-neutral-400 mb-2 block">Pilih Suara</label>
                    <select 
                      value={selectedGeminiVoice}
                      onChange={(e) => setSelectedGeminiVoice(e.target.value)}
                      className="w-full bg-neutral-950 border border-white/10 rounded-xl px-3 py-2.5 text-sm focus:border-lime-500 outline-none transition-all"
                    >
                      {GEMINI_VOICES.map(v => (
                        <option key={v.name} value={v.name}>{v.label}</option>
                      ))}
                    </select>
                  </div>

                  <div>
                    <label className="text-xs font-semibold text-neutral-400 mb-2 block">Style Instruction</label>
                    <div className="relative">
                      <MessageSquare className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-600" />
                      <input 
                        type="text" 
                        placeholder="Misal: Marah, Bisikan..."
                        value={styleInstruction}
                        onChange={(e) => setStyleInstruction(e.target.value)}
                        className="w-full bg-neutral-950 border border-white/10 rounded-xl pl-10 pr-3 py-2.5 text-sm focus:border-lime-500 outline-none transition-all"
                      />
                    </div>
                  </div>

                  <div className="flex flex-wrap gap-1.5">
                    {STYLE_PRESETS.map(preset => (
                      <button 
                        key={preset}
                        onClick={() => setStyleInstruction(preset)}
                        className="text-[10px] px-2 py-1 bg-neutral-800 hover:bg-neutral-700 rounded-lg text-neutral-400 transition-colors"
                      >
                        {preset}
                      </button>
                    ))}
                  </div>

                  <div className="pt-2">
                    <div className="bg-lime-500/5 border border-lime-500/20 rounded-xl p-3 flex items-center gap-3">
                      <Sparkles className="w-5 h-5 text-lime-500" />
                      <div>
                        <p className="text-[10px] font-bold text-lime-500 uppercase">Gratis & Cepat</p>
                        <p className="text-[9px] text-neutral-400">Ditenagai oleh Gemini 2.5 Flash</p>
                      </div>
                    </div>
                  </div>
                </div>
              ) : (
                <div className="space-y-4">
                  <div>
                    <label className="text-xs font-semibold text-neutral-400 mb-2 block">Voice Model</label>
                    <select 
                      value={selectedElevenVoiceId}
                      onChange={(e) => setSelectedElevenVoiceId(e.target.value)}
                      className="w-full bg-neutral-950 border border-white/10 rounded-xl px-3 py-2.5 text-sm focus:border-white outline-none transition-all"
                    >
                      {ELEVENLABS_PRESETS.map(v => (
                        <option key={v.id} value={v.id}>{v.name} ({v.description})</option>
                      ))}
                    </select>
                  </div>

                  {!elevenLabsApiKey && (
                    <div className="bg-orange-500/10 border border-orange-500/20 rounded-xl p-3 flex items-start gap-3">
                      <AlertCircle className="w-5 h-5 text-orange-500 shrink-0" />
                      <p className="text-[10px] text-orange-200/80 leading-relaxed">
                        API Key belum ada. Atur di menu Settings (ikon Gear) untuk menggunakan ElevenLabs.
                      </p>
                    </div>
                  )}
                </div>
              )}
            </div>

            {/* Statistik (Hidden on Mobile) */}
            <div className="hidden md:block bg-neutral-900 rounded-3xl border border-white/5 p-5 space-y-4">
              <div className="flex justify-between items-center text-[10px] font-bold text-neutral-500">
                <span className="uppercase">Panjang Karakter</span>
                <span className={script.length > 1000 ? 'text-orange-500' : 'text-lime-500'}>{script.length} / 2500</span>
              </div>
              <div className="h-1.5 w-full bg-neutral-950 rounded-full overflow-hidden border border-white/5">
                <div 
                  className="h-full bg-lime-500 transition-all duration-300" 
                  style={{ width: `${Math.min((script.length / 2500) * 100, 100)}%` }}
                />
              </div>
              <div className="text-[10px] text-neutral-500 flex justify-between">
                <span>Estimasi Waktu</span>
                <span>~{Math.ceil(script.length / 15)} Detik</span>
              </div>
            </div>
          </div>

          {/* Kolom Kanan: Editor & Output */}
          <div className="md:col-span-2 space-y-6">
            <div className="bg-neutral-900 rounded-3xl border border-white/5 overflow-hidden flex flex-col h-[480px]">
              <div className="px-5 py-4 border-b border-white/5 flex items-center justify-between bg-neutral-900/50">
                <span className="text-[10px] font-bold text-neutral-500 tracking-widest uppercase">Script Editor</span>
                <button 
                  onClick={handleAiAutoWrite}
                  disabled={isLoading || !script}
                  className="flex items-center gap-2 text-xs font-bold text-lime-500 hover:text-lime-400 transition-colors disabled:opacity-50"
                >
                  <Wand2 className="w-4 h-4" />
                  AI Auto-Write
                </button>
              </div>

              <textarea 
                value={script}
                onChange={(e) => setScript(e.target.value)}
                placeholder="Tulis bacotan kamu di sini..."
                className="flex-1 w-full bg-transparent p-6 text-lg resize-none outline-none text-white placeholder:text-neutral-700"
              />

              <div className="p-5 bg-neutral-950/30 border-t border-white/5">
                {error && (
                  <div className="mb-4 flex items-center gap-2 text-red-500 text-xs font-medium animate-in fade-in slide-in-from-top-1">
                    <AlertCircle className="w-4 h-4" />
                    {error}
                  </div>
                )}
                {success && (
                  <div className="mb-4 flex items-center gap-2 text-lime-500 text-xs font-medium animate-in fade-in slide-in-from-top-1">
                    <CheckCircle className="w-4 h-4" />
                    {success}
                  </div>
                )}
                
                <button 
                  onClick={handleGenerate}
                  disabled={isLoading}
                  className={`w-full py-4 rounded-2xl flex items-center justify-center gap-3 font-black text-lg transition-all active:scale-[0.98] ${
                    isLoading 
                      ? 'bg-neutral-800 text-neutral-500 cursor-not-allowed' 
                      : 'bg-gradient-to-r from-lime-500 to-lime-400 text-neutral-950 shadow-xl shadow-lime-500/20 hover:shadow-lime-500/40'
                  }`}
                >
                  {isLoading ? (
                    <Loader2 className="w-6 h-6 animate-spin" />
                  ) : (
                    <PlayCircle className="w-6 h-6" />
                  )}
                  {isLoading ? 'Sedang Memproses...' : 'Generate Suara Sekarang'}
                </button>
              </div>
            </div>

            {/* Result Player */}
            {audioUrl && (
              <div className="bg-neutral-800/50 rounded-3xl border border-lime-500/30 p-6 animate-in slide-in-from-bottom-4 duration-500">
                <div className="flex flex-col sm:flex-row items-center gap-6">
                  <div className="w-16 h-16 rounded-full bg-lime-500/20 flex items-center justify-center relative">
                    <div className="absolute inset-0 rounded-full border border-lime-500/40 animate-ping opacity-25" />
                    <Music className="w-8 h-8 text-lime-500" />
                  </div>
                  <div className="flex-1 space-y-3 w-full">
                    <div>
                      <h3 className="font-bold text-white">Audio Berhasil Dibuat</h3>
                      <p className="text-xs text-neutral-500">Klik play untuk mendengarkan hasil</p>
                    </div>
                    <audio 
                      controls 
                      src={audioUrl} 
                      className="w-full h-10 accent-lime-500"
                    />
                  </div>
                  <a 
                    href={audioUrl} 
                    download={`nyetak-audio-${Date.now()}.wav`}
                    className="p-4 bg-white text-neutral-950 rounded-2xl hover:bg-neutral-200 transition-colors shadow-lg"
                    title="Download File"
                  >
                    <Download className="w-6 h-6" />
                  </a>
                </div>
              </div>
            )}
          </div>
        </div>
      </main>

      {/* Modal Pengaturan (Overlay) */}
      {isSettingsOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-6 bg-black/90 backdrop-blur-sm animate-in fade-in">
          <div className="w-full max-w-md bg-neutral-900 rounded-3xl border border-white/10 shadow-2xl p-8 relative animate-in zoom-in-95 duration-200">
            <button 
              onClick={() => setIsSettingsOpen(false)}
              className="absolute top-6 right-6 p-1 text-neutral-500 hover:text-white transition-colors"
            >
              <X className="w-6 h-6" />
            </button>

            <div className="flex items-center gap-4 mb-8">
              <div className="w-12 h-12 rounded-2xl bg-lime-500/10 flex items-center justify-center">
                <Key className="w-6 h-6 text-lime-500" />
              </div>
              <div>
                <h2 className="text-xl font-black text-white">API Settings</h2>
                <p className="text-sm text-neutral-500">Konfigurasi kunci ElevenLabs</p>
              </div>
            </div>

            <div className="space-y-6">
              <div>
                <label className="text-xs font-bold text-neutral-400 mb-2 block uppercase tracking-wider">ElevenLabs API Key</label>
                <div className="relative">
                  <Key className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-600" />
                  <input 
                    type="password" 
                    placeholder="Enter your key..."
                    value={elevenLabsApiKey}
                    onChange={(e) => setElevenLabsApiKey(e.target.value)}
                    className="w-full bg-neutral-950 border border-white/10 rounded-2xl pl-12 pr-4 py-4 text-white focus:border-lime-500 outline-none transition-all"
                  />
                </div>
                <p className="mt-2 text-[10px] text-neutral-600 leading-relaxed">
                  Kunci API Anda disimpan secara lokal di sesi ini untuk memproses permintaan ke ElevenLabs secara langsung.
                </p>
              </div>

              <button 
                onClick={() => setIsSettingsOpen(false)}
                className="w-full py-4 bg-lime-500 text-neutral-950 font-black rounded-2xl hover:bg-lime-400 transition-all flex items-center justify-center gap-2"
              >
                <Save className="w-5 h-5" />
                Simpan & Tutup
              </button>
            </div>
          </div>
        </div>
      )}

      <footer className="max-w-4xl mx-auto px-6 py-12 border-t border-white/5 text-center">
        <p className="text-xs text-neutral-600 font-medium">NYETAK © 2025 • Designed for High Performance Bacotan</p>
      </footer>
    </div>
  );
}

